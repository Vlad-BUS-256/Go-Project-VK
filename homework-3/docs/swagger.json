{
    "swagger": "2.0",
    "info": {
        "description": "HTTP API для загрузки фильмов и поиска последнего фильма.",
        "title": "Movie API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/last-movie": {
            "get": {
                "description": "Находит фильм с максимальным существующим ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "movies"
                ],
                "summary": "Получить последний фильм",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/movie.Movie"
                        }
                    },
                    "404": {
                        "description": "Movie not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "Upstream error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/load-movies": {
            "get": {
                "description": "Загружает фильмы от from до to включительно",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "movies"
                ],
                "summary": "Загрузить фильмы по диапазону ID",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Начальный ID фильма",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Конечный ID фильма",
                        "name": "to",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/movie.Movie"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid movie range",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "Failed to load movies",
                        "schema": {
                            "$ref": "#/definitions/httpapi.PartialMoviesResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "httpapi.PartialMoviesResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "movies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/movie.Movie"
                    }
                }
            }
        },
        "movie.Movie": {
            "type": "object",
            "properties": {
                "director": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "year": {
                    "type": "integer"
                }
            }
        }
    }
}